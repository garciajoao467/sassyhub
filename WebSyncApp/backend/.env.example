# Configurações de Credenciais do Google Drive para Rclone
# Este arquivo serve de modelo. Crie um arquivo '.env' neste mesmo diretório e preencha com seus dados.
# O arquivo '.env' é ignorado pelo Git para segurança das credenciais.

RCLONE_DRIVE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
RCLONE_DRIVE_CLIENT_SECRET=seu_client_secret
RCLONE_DRIVE_TOKEN={"token_type":"Bearer","refresh_token":"seu_refresh_token"}
